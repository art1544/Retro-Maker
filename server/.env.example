# ============================================================
#  RetroMaker - configuração da IA que gera temas/dinâmicas
# ============================================================
# Por padrão NÃO precisa de nada aqui: usamos Pollinations (grátis, sem chave).
# Copie este arquivo para ".env" apenas se quiser trocar o provedor.

# Provedor: pollinations (padrão) | gemini | groq | openrouter | none
AI_PROVIDER=pollinations

# Modelo (opcional — cada provedor tem um default sensato)
# AI_MODEL=

# Timeout da chamada de IA em ms (padrão 20000)
# AI_TIMEOUT_MS=20000

# --- Chaves (só a do provedor escolhido é necessária) ---
# Gemini (free tier): https://aistudio.google.com/app/apikey
# GEMINI_API_KEY=

# Groq (free): https://console.groq.com/keys
# GROQ_API_KEY=

# OpenRouter (tem modelos :free): https://openrouter.ai/keys
# OPENROUTER_API_KEY=

# Porta do servidor (padrão 4000)
# PORT=4000
