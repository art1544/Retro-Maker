# ============================================================
#  RetroMaker - configuração da IA que gera temas/dinâmicas
# ============================================================
# Copie este arquivo para ".env" (na pasta server/) e ajuste.

# ---------- RECOMENDADO: Gemini (melhor qualidade) ----------
# Usa "structured output" do Gemini: a resposta é obrigada a seguir o schema,
# então os temas saem muito melhores e sem JSON quebrado.
# 1) Gere uma chave em: https://aistudio.google.com/apikey
# 2) Descomente as 2 linhas abaixo e cole sua chave:
# AI_PROVIDER=gemini
# GEMINI_API_KEY=cole_sua_chave_aqui
#
# Modelo (opcional). Padrão: gemini-3.5-flash (rápido e barato).
# Para máxima qualidade use gemini-3.5-pro (se sua chave tiver acesso).
# Não sabe quais pode usar? Acesse /api/ai/health — ele lista os modelos da sua chave.
# AI_MODEL=gemini-3.5-flash

# ---------- Padrão sem chave: Pollinations (grátis, mais fraco) ----------
AI_PROVIDER=pollinations

# ---------- Outras alternativas (via chave) ----------
# AI_PROVIDER=groq
# GROQ_API_KEY=            # https://console.groq.com/keys
# AI_PROVIDER=openrouter
# OPENROUTER_API_KEY=      # https://openrouter.ai/keys

# Timeout da chamada de IA em ms (padrão 20000)
# AI_TIMEOUT_MS=20000

# Porta do servidor (padrão 4000)
# PORT=4000
